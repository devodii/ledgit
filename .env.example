# Ledgit environment. Copy to .env: cp .env.example .env
# Only the blanks marked REQUIRED-SECRET need a real value from you.

# ---------------------------------------------------------------- general
# Optional, M0. "local" enables the admin tasks endpoint and dev conveniences.
# Use "production" for deployed builds. No value to obtain.
ENV=local

# ---------------------------------------------------------------- database
# Required, M0. Postgres container settings. Safe local defaults, no value to obtain.
POSTGRES_USER=ledgit
POSTGRES_PASSWORD=ledgit
POSTGRES_DB=ledgit
POSTGRES_PORT=5432
# Required, M0. libpq connection URL used by api and worker inside compose (host is the db service).
DATABASE_URL=postgresql://ledgit:ledgit@db:5432/ledgit

# Optional, M0. Host used by host-side tooling (task schema:plan/apply).
PGHOST=localhost
# Optional, M0. Docker image that runs pgschema migrations.
PGSCHEMA_IMAGE=pgplex/pgschema:latest
# Optional, M2. Path to a local pgschema binary; when set it is used instead of Docker.
PGSCHEMA_BIN=

# ---------------------------------------------------------------- api
# Optional, M0. Port the FastAPI server is published on.
API_PORT=8000
# Optional, M0. Comma separated origins allowed by CORS.
API_CORS_ORIGINS=http://localhost:5173
# Optional, M0. Log level for api and worker.
LOG_LEVEL=INFO
# Optional, M3. Contact URL placed in the User-Agent of every outbound request so
# site operators can reach us. Set to your repo or site URL.
HTTP_CONTACT_URL=https://github.com/devodii/ledgit
# Optional, M3. Default outbound rate limit per host, requests per second.
HTTP_RATE_LIMIT_RPS=1
# Optional, M3. When the system resolver fails for a host, retry the lookup through
# Cloudflare DNS over HTTPS (only the failing hostnames are sent). 1 or 0.
DNS_FALLBACK=1
# Optional, M3. Outbound request timeout in seconds.
HTTP_TIMEOUT_SECONDS=20
# Optional, M3. Disk cache directory for fetched responses (git-ignored).
CACHE_DIR=/app/data/cache
# Optional, M3. Directory for the human task log read by `make watch-tasks`.
TASKS_DIR=/app/data/tasks
# Optional, M5. Horizon and Soroban RPC public endpoints, no key needed. horizon.stellar.org
# no longer resolves, so the default is a public community Horizon.
HORIZON_URL=https://horizon.stellar.lobstr.co
HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
SOROBAN_RPC_TESTNET_URL=https://soroban-testnet.stellar.org
STELLAR_EXPERT_URL=https://api.stellar.expert
# Optional, M5. Verification thresholds.
VERIFY_MIN_ASSET_HOLDERS=10
VERIFY_CONTRACT_ACTIVITY_DAYS=30
# Optional, M4. Claims below this confidence go to data/review/ instead of the public registry.
PIPELINE_MIN_CONFIDENCE=0.7
# Optional, M3. Repo-relative data directory used by the pipeline.
DATA_DIR=/app/data

# ---------------------------------------------------------------- web
# Optional, M0. Port the Vite dev server is published on.
WEB_PORT=5173
# Optional, M0. Where the Vite dev server proxies /api (api service inside compose).
VITE_API_PROXY_TARGET=http://api:8000
# Optional, M0. Port Storybook is published on.
STORYBOOK_PORT=6006
# Optional, M6. GitHub repo that receives correction issues via prefilled links.
VITE_GITHUB_REPO=devodii/ledgit
# Optional, M7. Public site URL used for Open Graph tags and the sitemap.
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------- llm
# Optional, M4. Provider id: claude_code | anthropic | openai | fake.
# claude_code runs extraction through the local Claude Code CLI (`claude -p`), so
# no API key is needed while developing. It runs on the host, not inside Docker.
# Switch to anthropic or openai for production once you have a model and key.
LLM_PROVIDER=claude_code
# Required only for anthropic or openai, M4. Model name from your provider's docs.
# Optional for claude_code (empty uses the CLI default). Never hardcoded in code.
LLM_MODEL=
# REQUIRED-SECRET only for anthropic or openai, M4. Get it from your provider's
# console (console.anthropic.com or platform.openai.com) under API keys.
LLM_API_KEY=
# Optional, M4. Max tokens per extraction call.
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------- youtube
# Optional, M3. Without it the youtube connector uses a keyless fallback.
# Get it from Google Cloud console: enable YouTube Data API v3, create an API key.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------- browser
# Optional, M3. Set to 1 to open a visible Chromium when you need to solve a
# captcha or login by hand. Only works when the worker runs on your host.
BROWSER_HEADFUL=0
# Optional, M3. Persistent browser profile directory.
BROWSER_PROFILE_DIR=/app/data/cache/browser
# Optional, M3. Default page timeout in milliseconds.
BROWSER_TIMEOUT_MS=30000

# ---------------------------------------------------------------- scheduler
# Optional, M5. Set to 1 to run the daily verification job inside the worker.
SCHEDULER_ENABLED=1
# Optional, M5. Cron expression (UTC) for the daily verification run.
VERIFY_CRON=0 6 * * *
